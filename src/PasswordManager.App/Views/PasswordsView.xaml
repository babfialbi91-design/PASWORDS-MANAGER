<UserControl x:Class="PasswordManager.App.Views.PasswordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PasswordManager.App"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <app:StrengthLabelConverter x:Key="StrengthLabel"/>
        <app:StrengthColorConverter x:Key="StrengthColor"/>
        <app:EmptyToDashConverter x:Key="Dash"/>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2D36"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Grid>
            <StackPanel>
                <TextBlock Text="🔑  كلمات المرور" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- شريط الأدوات -->
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,0">
                <DockPanel>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="SearchBox" Text="" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                             ToolTip="ابحث بالعنوان أو المستخدم أو الموقع"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="AddButton" Content="➕  إضافة" Style="{StaticResource PrimaryButton}" Click="AddButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- قائمة المدخلات -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <ListView x:Name="EntriesList" Background="Transparent" BorderThickness="0"
                          SelectionChanged="EntriesList_SelectionChanged" MouseDoubleClick="EntriesList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="العنوان" Width="190" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="اسم المستخدم" Width="180" DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="الموقع" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Website, Converter={StaticResource Dash}}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="القوة" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Password, Converter={StaticResource StrengthLabel}}">
                                            <TextBlock.Foreground>
                                                <Binding Path="Password" Converter="{StaticResource StrengthColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="آخر تعديل" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd}}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock x:Name="EmptyText" Text="لا توجد كلمات مرور محفوظة بعد — اضغط «إضافة» للبدء"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="14" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- تفاصيل المدخل المحدد -->
        <Border x:Name="DetailsPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,14,0,0"
                Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailsTitle" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="CopyUsernameButton" Content="👤 اسم المستخدم" Style="{StaticResource GhostButton}" Margin="4,0" Click="CopyUsername_Click"/>
                            <Button x:Name="CopyPasswordButton" Content="📋 كلمة المرور" Style="{StaticResource PrimaryButton}" Margin="4,0" Click="CopyPassword_Click"/>
                            <Button x:Name="ToggleRevealButton" Content="👁️ إظهار" Style="{StaticResource GhostButton}" Margin="4,0" Click="ToggleReveal_Click"/>
                            <Button x:Name="EditButton" Content="✏️" Style="{StaticResource GhostButton}" Margin="4,0" Click="EditButton_Click" ToolTip="تعديل"/>
                            <Button x:Name="DeleteButton" Content="🗑️" Style="{StaticResource DangerButton}" Margin="4,0" Click="DeleteButton_Click" ToolTip="حذف"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DetailsMeta" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PasswordDisplay" FontSize="14" FontFamily="Consolas" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
