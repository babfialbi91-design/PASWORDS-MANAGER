<UserControl x:Class="PasswordManager.App.Views.BrowsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PasswordManager.App">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24">

            <TextBlock Text="{Binding [Bridge_Title], Source={x:Static loc:Localization.Instance}}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding [Bridge_Sub], Source={x:Static loc:Localization.Instance}}"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16"/>

            <!-- شبكة المتصفحات -->
            <TextBlock Text="{Binding [Bridge_BrowsersList], Source={x:Static loc:Localization.Instance}}"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <WrapPanel x:Name="CardsPanel"/>

            <!-- تعليمات ربط الامتداد -->
            <Border x:Name="InstructionPanel" Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="22,16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="InstructionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="InstructionText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="OpenFolderButton" Content="{Binding [Bridge_OpenFolder], Source={x:Static loc:Localization.Instance}}"
                                Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click"/>
                        <Button Content="{Binding [Settings_CopyPath], Source={x:Static loc:Localization.Instance}}"
                                Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="CopyPath_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- جسر الكتابة -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="22,16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Bridge_HotkeyTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding [Bridge_HotkeyDesc], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox x:Name="TypingEnabledCheck" Content="{Binding [Bridge_TypingEnabled], Source={x:Static loc:Localization.Instance}}"
                              Margin="0,0,0,10" Checked="TypingEnabled_Changed" Unchecked="TypingEnabled_Changed"/>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="14,9">
                            <TextBlock x:Name="HotkeyText" FontSize="13" FontFamily="Consolas"/>
                        </Border>
                        <Button x:Name="ChangeHotkeyButton" Content="{Binding [Bridge_HotkeyChange], Source={x:Static loc:Localization.Instance}}"
                                Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ChangeHotkey_Click"/>
                        <TextBlock x:Name="CaptureTip" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusMessage" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
