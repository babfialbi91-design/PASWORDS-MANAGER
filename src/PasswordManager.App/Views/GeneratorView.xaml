<UserControl x:Class="PasswordManager.App.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PasswordManager.App">

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding [Gen_Title], Source={x:Static loc:Localization.Instance}}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding [Gen_Sub], Source={x:Static loc:Localization.Instance}}"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- لوحة الخيارات -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Gen_Length], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="LengthValue" Grid.Column="1" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Slider x:Name="LengthSlider" Minimum="8" Maximum="64" Value="18" IsSnapToTickEnabled="True"
                            TickFrequency="1" Margin="0,6,0,18" ValueChanged="Options_Changed"/>

                    <CheckBox x:Name="UseUpper" Content="{Binding [Gen_Upper], Source={x:Static loc:Localization.Instance}}" IsChecked="True" Margin="0,4"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <CheckBox x:Name="UseLower" Content="{Binding [Gen_Lower], Source={x:Static loc:Localization.Instance}}" IsChecked="True" Margin="0,4"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <CheckBox x:Name="UseDigits" Content="{Binding [Gen_Digits], Source={x:Static loc:Localization.Instance}}" IsChecked="True" Margin="0,4"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <CheckBox x:Name="UseSymbols" Content="{Binding [Gen_Symbols], Source={x:Static loc:Localization.Instance}}" IsChecked="True" Margin="0,4"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>
                    <CheckBox x:Name="ExcludeAmbiguous" Content="{Binding [Gen_ExcludeAmbiguous], Source={x:Static loc:Localization.Instance}}" IsChecked="False" Margin="0,4"
                              Checked="Options_Changed" Unchecked="Options_Changed"/>

                    <Button Content="{Binding [Gen_GenerateNow], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                            Click="GenerateButton_Click"/>
                </StackPanel>
            </Border>

            <!-- لوحة النتيجة -->
            <Border Grid.Column="1" Margin="16,0,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding [Gen_GeneratedLabel], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,20" Margin="0,10,0,0">
                        <TextBlock x:Name="ResultText" FontFamily="Consolas" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="—"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Gen_Strength], Source={x:Static loc:Localization.Instance}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="StrengthText" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Gen_Entropy], Source={x:Static loc:Localization.Instance}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="EntropyText" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button x:Name="CopyButton" Content="{Binding [Gen_Copy], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" MinWidth="110" Click="CopyButton_Click"/>
                        <Button x:Name="SaveButton" Content="{Binding [Gen_Save], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="12,0,0,0" Click="SaveButton_Click"/>
                        <Button Content="{Binding [Gen_New], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}" MinWidth="120" Margin="12,0,0,0" Click="GenerateButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="NoticeText" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
