<UserControl x:Class="PasswordManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24">

            <TextBlock Text="⚙️  الإعدادات" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="إدارة الأمان وملف الخزنة"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,18"/>

            <!-- تغيير كلمة المرور -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="🔁  تغيير كلمة المرور الرئيسية" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                    <TextBlock Text="كلمة المرور الحالية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="CurrentPasswordBox" Padding="10,8"/>

                    <TextBlock Text="كلمة المرور الجديدة" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="NewPasswordBox" Padding="10,8"/>

                    <TextBlock Text="تأكيد كلمة المرور الجديدة" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,8"/>

                    <TextBlock x:Name="ChangeMessage" FontSize="12" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" Margin="0,12,0,0"/>

                    <Button Content="تغيير كلمة المرور" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" MinWidth="160" Margin="0,16,0,0" Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>

            <!-- إدارة الخزنة -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="🗄️  ملف الخزنة" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,9">
                            <TextBlock x:Name="VaultPathText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"/>
                        </Border>
                        <Button Grid.Column="1" Content="📋 نسخ المسار" Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0" Click="CopyPath_Click"/>
                    </Grid>

                    <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="إعادة تعيين الخزنة — يحذف كل كلمات المرور وحسابات TOTP نهائياً"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <Button Content="🗑️  إعادة تعيين الخزنة" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" MinWidth="200" Margin="0,12,0,0" Click="ResetVault_Click"/>
                </StackPanel>
            </Border>

            <!-- حول -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ️  حول" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="مدير كلمات المرور — الإصدار 1.0.0"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="تشفير AES-256-GCM مع مفتاح PBKDF2-SHA256 (600,000 جولة) — جميع البيانات محلية على جهازك."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
