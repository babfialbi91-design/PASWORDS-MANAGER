<UserControl x:Class="PasswordManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PasswordManager.App">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24">

            <TextBlock Text="{Binding [Settings_Title], Source={x:Static loc:Localization.Instance}}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding [Settings_Sub], Source={x:Static loc:Localization.Instance}}"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,18"/>

            <!-- اللغة -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_LangTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding [Settings_LangLabel], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left"
                              SelectionChanged="LanguageBox_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- الأمان -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_SecurityTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding [Settings_AutoLockLabel], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <ComboBox x:Name="AutoLockBox" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="AutoLockBox_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- تغيير كلمة المرور -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_ChangeTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding [Settings_CurrentPw], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="CurrentPasswordBox" Padding="10,8"/>

                    <TextBlock Text="{Binding [Settings_NewPw], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="NewPasswordBox" Padding="10,8"/>

                    <TextBlock Text="{Binding [Settings_ConfirmPw], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="10,8"/>

                    <TextBlock x:Name="ChangeMessage" FontSize="12" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" Margin="0,12,0,0"/>

                    <Button Content="{Binding [Settings_ChangeBtn], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" MinWidth="160" Margin="0,16,0,0" Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>

            <!-- إدارة الخزنة -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_VaultTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,9">
                            <TextBlock x:Name="VaultPathText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"/>
                        </Border>
                        <Button Grid.Column="1" Content="{Binding [Settings_CopyPath], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0" Click="CopyPath_Click"/>
                    </Grid>

                    <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                    <TextBlock Text="{Binding [Settings_ResetDesc], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <Button Content="{Binding [Settings_ResetBtn], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" MinWidth="200" Margin="0,12,0,0" Click="ResetVault_Click"/>
                </StackPanel>
            </Border>

            <!-- التحديثات -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_UpdateTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CurrentVersionText" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding [Settings_CheckBtn], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}"
                                    Margin="10,0,0,0" Click="CheckUpdates_Click"/>
                            <Button x:Name="DownloadUpdateButton" Content="{Binding [Settings_DownloadBtn], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}"
                                    Margin="10,0,0,0" Visibility="Collapsed" Click="DownloadUpdate_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding [Settings_UpdateNote], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- سطح المكتب -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_AccessTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding [Settings_AccessDesc], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{Binding [Settings_ShortcutBtn], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Click="CreateShortcut_Click"/>
                        <TextBlock x:Name="ShortcutMessage" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- حول -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22,18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding [Settings_AboutTitle], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AboutVersionText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding [Settings_AboutCrypto], Source={x:Static loc:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding [Settings_AboutSignature], Source={x:Static loc:Localization.Instance}}"
                               FontSize="15" FontFamily="Segoe Script" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
