<Window x:Class="PasswordManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PasswordManager.App"
        xmlns:views="clr-namespace:PasswordManager.App.Views"
        Title="{Binding [App_Title], Source={x:Static loc:Localization.Instance}}"
        Height="760" Width="1120"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- شاشة الدخول -->
        <views:LoginView x:Name="LoginView"/>

        <!-- لوحة التحكم -->
        <Grid x:Name="Dashboard" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الشريط الجانبي -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                        <TextBlock Text="🔐" FontSize="34" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding [App_Title], Source={x:Static loc:Localization.Instance}}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="VaultStatusText" Text="{Binding [Sidebar_VaultOpen], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,12">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [Sidebar_VaultFile], Source={x:Static loc:Localization.Instance}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="VaultPathText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LockButton" Content="{Binding [Sidebar_Lock], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="LockButton_Click"/>
                    </StackPanel>

                    <StackPanel>
                        <Button x:Name="NavPasswords" Content="{Binding [Sidebar_NavPasswords], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource NavButton}" Background="#23252E" Click="NavButton_Click" Tag="passwords"/>
                        <Button x:Name="NavGenerator" Content="{Binding [Sidebar_NavGenerator], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource NavButton}" Click="NavButton_Click" Tag="generator"/>
                        <Button x:Name="NavTotp" Content="{Binding [Sidebar_NavTotp], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource NavButton}" Click="NavButton_Click" Tag="totp"/>
                        <Button x:Name="NavBrowsers" Content="{Binding [Sidebar_NavBrowsers], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource NavButton}" Click="NavButton_Click" Tag="browsers"/>
                        <Button x:Name="NavSettings" Content="{Binding [Sidebar_NavSettings], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource NavButton}" Click="NavButton_Click" Tag="settings"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- منطقة المحتوى -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط التحديثات -->
                <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed"
                        Background="#1B4D2E" CornerRadius="0" Padding="20,10" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdateBarText" Text="{Binding [Update_BarGeneric], Source={x:Static loc:Localization.Instance}}" FontSize="13"
                                       Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button x:Name="UpdateDownloadButton" Content="{Binding [Update_Download], Source={x:Static loc:Localization.Instance}}" FontSize="12"
                                    Foreground="White" Background="#2E7D4F" BorderThickness="0"
                                    Padding="12,5" Margin="16,0,0,0" Cursor="Hand"
                                    Click="UpdateDownloadButton_Click"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Foreground="#BFE3CE" Background="Transparent"
                                BorderThickness="0" FontSize="14" Cursor="Hand" Click="DismissUpdateBar_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <views:PasswordsView x:Name="PasswordsView" Visibility="Visible"/>
                    <views:GeneratorView x:Name="GeneratorView" Visibility="Collapsed"/>
                    <views:TotpView x:Name="TotpView" Visibility="Collapsed"/>
                    <views:BrowsersView x:Name="BrowsersView" Visibility="Collapsed"/>
                    <views:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- وميض فتح الخزنة -->
        <Grid x:Name="UnlockOverlay" Visibility="Collapsed" Background="#000000" IsHitTestVisible="False">
            <TextBlock x:Name="UnlockBurst" Text="✳" FontSize="88" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
        </Grid>
    </Grid>
</Window>
