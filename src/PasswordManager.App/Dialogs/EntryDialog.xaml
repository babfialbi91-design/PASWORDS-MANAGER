<Window x:Class="PasswordManager.App.Dialogs.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PasswordManager.App"
        Title="{Binding [Entry_TitleAdd], Source={x:Static loc:Localization.Instance}}" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="WindowTitle" Text="{Binding [Entry_TitleAdd], Source={x:Static loc:Localization.Instance}}" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>

            <TextBlock Text="{Binding [Entry_FieldTitle], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleInput"/>

            <TextBlock Text="{Binding [Entry_FieldUsername], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
            <TextBox x:Name="UsernameInput"/>

            <TextBlock Text="{Binding [Entry_FieldWebsite], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
            <TextBox x:Name="WebsiteInput"/>

            <TextBlock Text="{Binding [Entry_FieldCategory], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
            <TextBox x:Name="CategoryInput" Text="عام"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding [Entry_FieldPassword], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="PasswordInput" FontFamily="Consolas"/>
                </StackPanel>
                <Button x:Name="GenerateButton" Grid.Column="1" Content="{Binding [Entry_Generate], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                        Margin="8,22,0,0" Click="GenerateButton_Click"/>
                <Button x:Name="CopyGeneratedButton" Grid.Column="2" Content="{Binding [Common_Copy], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}"
                        Margin="6,22,0,0" Click="CopyGeneratedButton_Click"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="StrengthText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>

            <TextBlock Text="{Binding [Entry_FieldNotes], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,5"/>
            <TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="{Binding [Entry_Save], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="SaveButton_Click"/>
            <Button Content="{Binding [Common_Cancel], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}" MinWidth="90" Margin="10,0,0,0" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
