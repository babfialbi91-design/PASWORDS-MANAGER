<Window x:Class="PasswordManager.App.Dialogs.TotpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PasswordManager.App"
        Title="{Binding [TotpDialog_Title], Source={x:Static loc:Localization.Instance}}" Height="580" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding [TotpDialog_Header], Source={x:Static loc:Localization.Instance}}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding [TotpDialog_Secret], Source={x:Static loc:Localization.Instance}}"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="SecretInput" Padding="10,8" FontFamily="Consolas"
                     TextChanged="SecretInput_TextChanged" ToolTip="{Binding [TotpDialog_SecretTip], Source={x:Static loc:Localization.Instance}}"/>

            <TextBlock Text="{Binding [TotpDialog_Name], Source={x:Static loc:Localization.Instance}}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,5"/>
            <TextBox x:Name="NameInput" Padding="10,8"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{Binding [TotpDialog_Algorithm], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AlgorithmBox" SelectedIndex="0">
                        <ComboBoxItem Content="SHA1"/>
                        <ComboBoxItem Content="SHA256"/>
                        <ComboBoxItem Content="SHA512"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0">
                    <TextBlock Text="{Binding [TotpDialog_Digits], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="DigitsBox" SelectedIndex="0">
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                    <TextBlock Text="{Binding [TotpDialog_Period], Source={x:Static loc:Localization.Instance}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PeriodBox" SelectedIndex="0">
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="60"/>
                        <ComboBoxItem Content="90"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [TotpDialog_Current], Source={x:Static loc:Localization.Instance}}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0"/>
                    <Button Content="{Binding [TotpDialog_Preview], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}" Margin="16,0,0,0"
                            HorizontalAlignment="Left" Click="PreviewButton_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="{Binding [TotpDialog_Save], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="SaveButton_Click"/>
            <Button Content="{Binding [Common_Cancel], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource GhostButton}" MinWidth="90" Margin="10,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
