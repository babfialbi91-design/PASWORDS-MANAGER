<Window x:Class="PasswordManager.App.Dialogs.TotpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة حساب TOTP" Height="580" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI"
        FlowDirection="RightToLeft" WindowStyle="SingleBorderWindow">

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="⏱️ إضافة حساب TOTP" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="المفتاح السري (Secret) أو رابط otpauth:// كاملاً"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="SecretInput" Padding="10,8" FontFamily="Consolas"
                     TextChanged="SecretInput_TextChanged" ToolTip="الصق المفتاح من الموقع مثل JBSWY3DPEHPK3PXP أو رابط otpauth الكامل"/>

            <TextBlock Text="اسم الحساب (مثال: Google، GitHub)" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,5"/>
            <TextBox x:Name="NameInput" Padding="10,8"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="الخوارزمية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AlgorithmBox" SelectedIndex="0">
                        <ComboBoxItem Content="SHA1"/>
                        <ComboBoxItem Content="SHA256"/>
                        <ComboBoxItem Content="SHA512"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0">
                    <TextBlock Text="عدد الخانات" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="DigitsBox" SelectedIndex="0">
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                    <TextBlock Text="الفترة (ثوانٍ)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PeriodBox" SelectedIndex="0">
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="60"/>
                        <ComboBoxItem Content="90"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="الرمز الحالي:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0"/>
                    <Button Content="🔍 معاينة" Style="{StaticResource GhostButton}" Margin="16,0,0,0"
                            HorizontalAlignment="Left" Click="PreviewButton_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="💾  حفظ الحساب" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="SaveButton_Click"/>
            <Button Content="إلغاء" Style="{StaticResource GhostButton}" MinWidth="90" Margin="10,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
